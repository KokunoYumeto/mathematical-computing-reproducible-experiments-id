{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/o002/catalog.schema.json",
  "title": "O002 locale-neutral curriculum backend",
  "type": "object",
  "required": [
    "schema_version",
    "language",
    "course",
    "sources",
    "components",
    "units",
    "relations",
    "qa",
    "historical_release",
    "architecture",
    "cursor"
  ],
  "properties": {
    "schema_version": {"const": "o002.backend.v2"},
    "language": {"const": "id-ID"},
    "course": {
      "type": "object",
      "required": ["id", "project_id", "title", "prerequisite", "selected_unit_count"],
      "properties": {
        "id": {"const": "B80"},
        "project_id": {"const": "O002"},
        "title": {"type": "string", "minLength": 1},
        "prerequisite": {"const": "A30"},
        "selected_unit_count": {"const": 14}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "components": {
      "type": "array",
      "items": {"$ref": "#/$defs/component"}
    },
    "units": {
      "type": "array",
      "items": {"$ref": "#/$defs/unit"}
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "from", "to"],
        "properties": {
          "type": {"enum": ["precedes", "uses_component", "implements"]},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "qa": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^qa-o002-"},
          "status": {"enum": ["pass", "pending", "not_applicable"]},
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "historical_release": {
      "type": "object",
      "required": ["version", "tag", "doi", "unit_count", "exercise_count", "verified"],
      "properties": {
        "version": {"const": "2026.08.22"},
        "tag": {"const": "v2026.08.22"},
        "doi": {"const": "10.5281/zenodo.22052053"},
        "unit_count": {"const": 12},
        "exercise_count": {"const": 60},
        "verified": {"const": true}
      },
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "required": ["status", "required_unit_ids", "admitted_unit_ids", "open_requirements"],
      "properties": {
        "status": {"enum": ["in_progress", "complete"]},
        "required_unit_ids": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^o002\\.(?:p|u)[0-9]{2}$"}
        },
        "admitted_unit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^o002\\.(?:p|u)[0-9]{2}$"}
        },
        "open_requirements": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "cursor": {
      "type": "object",
      "required": ["last_admitted_unit", "next_unit", "boundary", "standalone_edition_complete", "b80_curriculum_complete", "admitted_unit_count", "selected_unit_count"],
      "properties": {
        "last_admitted_unit": {"type": "string", "pattern": "^o002\\.(?:p|u)[0-9]{2}$"},
        "next_unit": {
          "oneOf": [
            {"type": "string", "pattern": "^o002\\.(?:p|u)[0-9]{2}$"},
            {"type": "null"}
          ]
        },
        "boundary": {"type": "string", "minLength": 1},
        "standalone_edition_complete": {"type": "boolean"},
        "b80_curriculum_complete": {"type": "boolean"},
        "admitted_unit_count": {"type": "integer", "minimum": 0, "maximum": 14},
        "selected_unit_count": {"const": 14}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "title", "role", "license", "identity"],
      "properties": {
        "id": {"type": "string", "pattern": "^src-o002-"},
        "title": {"type": "string", "minLength": 1},
        "role": {"enum": ["original", "bounded_donor", "comparison_only"]},
        "license": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "used_in_current_units": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["id", "kind", "source", "license", "path"],
      "properties": {
        "id": {"type": "string", "pattern": "^cmp-o002-"},
        "kind": {"enum": ["reader_text", "software", "data", "figure"]},
        "source": {"type": "string", "pattern": "^src-o002-"},
        "license": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "required": ["id", "title", "standalone_status", "curriculum_status", "reader_path", "sections", "exercises", "components"],
      "properties": {
        "id": {"type": "string", "pattern": "^o002\\.(?:p|u)[0-9]{2}$"},
        "title": {"type": "string", "minLength": 1},
        "standalone_status": {"enum": ["complete", "not_applicable"]},
        "curriculum_status": {"enum": ["complete", "repair_required", "in_progress", "planned"]},
        "reader_path": {"type": "string", "minLength": 1},
        "sections": {
          "type": "array",
          "items": {"type": "string", "pattern": "^sec-o002-(?:p|u)[0-9]{2}"}
        },
        "exercises": {
          "type": "array",
          "items": {"type": "string", "pattern": "^ex-o002-(?:p|u)[0-9]{2}-[0-9]{2}$"}
        },
        "components": {
          "type": "array",
          "items": {"type": "string", "pattern": "^cmp-o002-"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
