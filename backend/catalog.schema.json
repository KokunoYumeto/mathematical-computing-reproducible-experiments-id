{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/o002/catalog.schema.json",
  "title": "O002 locale-neutral curriculum backend",
  "type": "object",
  "required": [
    "schema_version",
    "language",
    "course",
    "sources",
    "components",
    "units",
    "relations",
    "qa",
    "cursor"
  ],
  "properties": {
    "schema_version": {"const": "o002.backend.v1"},
    "language": {"const": "id-ID"},
    "course": {
      "type": "object",
      "required": ["id", "project_id", "title", "prerequisite"],
      "properties": {
        "id": {"const": "B80"},
        "project_id": {"const": "O002"},
        "title": {"type": "string", "minLength": 1},
        "prerequisite": {"const": "A30"}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "components": {
      "type": "array",
      "items": {"$ref": "#/$defs/component"}
    },
    "units": {
      "type": "array",
      "items": {"$ref": "#/$defs/unit"}
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "from", "to"],
        "properties": {
          "type": {"enum": ["precedes", "uses_component", "implements"]},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "qa": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^qa-o002-"},
          "status": {"enum": ["pass", "pending", "not_applicable"]},
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "cursor": {
      "type": "object",
      "required": ["last_complete_unit", "next_unit", "boundary"],
      "properties": {
        "last_complete_unit": {"type": "string", "pattern": "^o002\\.u[0-9]{2}$"},
        "next_unit": {
          "oneOf": [
            {"type": "string", "pattern": "^o002\\.u[0-9]{2}$"},
            {"type": "null"}
          ]
        },
        "boundary": {"type": "string", "minLength": 1},
        "edition_complete": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "title", "role", "license", "identity"],
      "properties": {
        "id": {"type": "string", "pattern": "^src-o002-"},
        "title": {"type": "string", "minLength": 1},
        "role": {"enum": ["original", "bounded_donor", "comparison_only"]},
        "license": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "used_in_current_units": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["id", "kind", "source", "license", "path"],
      "properties": {
        "id": {"type": "string", "pattern": "^cmp-o002-"},
        "kind": {"enum": ["reader_text", "software", "data", "figure"]},
        "source": {"type": "string", "pattern": "^src-o002-"},
        "license": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "required": ["id", "title", "status", "reader_path", "sections", "exercises", "components"],
      "properties": {
        "id": {"type": "string", "pattern": "^o002\\.u[0-9]{2}$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["complete", "in_progress", "planned"]},
        "reader_path": {"type": "string", "minLength": 1},
        "sections": {
          "type": "array",
          "items": {"type": "string", "pattern": "^sec-o002-u[0-9]{2}"}
        },
        "exercises": {
          "type": "array",
          "items": {"type": "string", "pattern": "^ex-o002-u[0-9]{2}-[0-9]{2}$"}
        },
        "components": {
          "type": "array",
          "items": {"type": "string", "pattern": "^cmp-o002-"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
